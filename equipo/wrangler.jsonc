// App del equipo de Jardinería Adrover (Worker «equipo»): fichajes y partes desde el móvil.
// Usa la misma base D1 que la gestión, así lo que ponen los operarios aparece en la gestión al momento.
{
  "name": "equipo",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [{ "binding": "DB", "database_name": "jardineria-adrover-gestion", "database_id": "e74eb7e7-c0c6-41d0-933f-a6e5772d270e" }]
}
